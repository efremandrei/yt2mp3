<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp">
   <TextView android:id="@+id/title_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textSize="24sp" android:textStyle="bold" />
   <Button android:id="@+id/light_skin_button" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/skin_light" android:contentDescription="@string/skin_light_description" android:textSize="20sp" />
   <Button android:id="@+id/dark_skin_button" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/skin_dark" android:contentDescription="@string/skin_dark_description" android:textSize="20sp" />
   <Button android:id="@+id/info_button" android:layout_width="68dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:padding="0dp" android:text="@string/info" android:textAllCaps="false" android:textSize="13sp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/content_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="28dp">
   <TextView android:tag="heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_title" android:textSize="32sp" android:fontFamily="sans-serif-medium" />
   <TextView android:tag="muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/hero_subtitle" android:textSize="15sp" android:lineSpacingExtra="3dp" />
   <LinearLayout android:id="@+id/link_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="18dp" android:orientation="vertical">
    <TextView android:tag="heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/link_title" android:textSize="16sp" android:textStyle="bold" android:labelFor="@id/url_input" />
    <EditText android:id="@+id/url_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="60dp" android:padding="14dp" android:hint="@string/url_hint" android:inputType="textUri" android:singleLine="true" android:imeOptions="actionNext" android:autofillHints="" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
     <Button android:id="@+id/paste_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/paste" android:textAllCaps="false" />
     <Button android:id="@+id/clear_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/clear" android:textAllCaps="false" android:contentDescription="@string/clear_url" />
    </LinearLayout>
   </LinearLayout>
   <LinearLayout android:id="@+id/output_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="18dp" android:orientation="vertical">
    <TextView android:tag="heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/output_title" android:textSize="16sp" android:textStyle="bold" android:labelFor="@id/filename_input" />
    <EditText android:id="@+id/filename_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:padding="14dp" android:hint="@string/filename_hint" android:inputType="textCapSentences" android:singleLine="true" android:imeOptions="actionDone" android:autofillHints="" android:textSize="15sp" />
    <TextView android:tag="muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/filename_help" android:textSize="12sp" />
    <TextView android:id="@+id/output_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:lineSpacingExtra="2dp" android:textIsSelectable="true" />
   </LinearLayout>
   <Button android:id="@+id/convert_button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="20dp" android:text="@string/convert" android:textAllCaps="false" android:textSize="17sp" />
   <LinearLayout android:id="@+id/status_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:orientation="vertical">
    <TextView android:tag="muted" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/activity_title" android:textSize="11sp" android:letterSpacing="0.15" android:textStyle="bold" />
    <TextView android:id="@+id/status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/preparing" android:textSize="14sp" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="14dp" android:max="100" android:visibility="gone" />
    <Button android:id="@+id/cancel_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="@string/cancel" android:textAllCaps="false" android:visibility="gone" />
   </LinearLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
    <Button android:id="@+id/open_downloads_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/open_downloads" android:textAllCaps="false" android:textSize="13sp" />
    <Button android:id="@+id/update_engine_button" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/update_engine" android:textAllCaps="false" android:textSize="13sp" />
   </LinearLayout>
   <TextView android:id="@+id/footer_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/usage_note" android:textSize="12sp" android:gravity="center" />
  </LinearLayout>
 </LinearLayout>
</ScrollView>
